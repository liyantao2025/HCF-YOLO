*.bak
~$*

# Dataset contents are not redistributed. Directory placeholders and the
# dataset instructions remain versioned.
dataset/images/train/*
dataset/images/val/*
dataset/images/test/*
dataset/images/train_improved/
dataset/labels/train/*
dataset/labels/val/*
dataset/labels/test/*
dataset/labels/train_improved/
!dataset/images/train/.gitkeep
!dataset/images/val/.gitkeep
!dataset/images/test/.gitkeep
!dataset/labels/train/.gitkeep
!dataset/labels/val/.gitkeep
!dataset/labels/test/.gitkeep
